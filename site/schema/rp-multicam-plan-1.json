{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r-multicam.pages.dev/schema/rp-multicam-plan-1.json",
  "title": "R Project multicam plan (rp-multicam-plan/1)",
  "description": "Host-neutral multicam edit produced by the R Project Multicam AI engine. Times are seconds on the music timeline; *_frame fields are exact frame indices at timeline.fps. Premiere and Final Cut Pro (FCPXML) exports are generated from this same object.",
  "type": "object",
  "required": ["format", "version", "generator", "timeline", "music", "cameras", "cuts"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "rp-multicam-plan" },
    "version": { "const": 1 },
    "generator": {
      "type": "object",
      "required": ["name", "model"],
      "properties": {
        "name": { "type": "string" },
        "model": { "type": "string" },
        "plugin_version": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "timeline": {
      "type": "object",
      "required": ["fps", "duration", "duration_frames"],
      "properties": {
        "fps": {
          "type": "object",
          "required": ["num", "den"],
          "properties": { "num": { "type": "integer", "minimum": 1 }, "den": { "type": "integer", "minimum": 1 } },
          "description": "Exact frame rate num/den, e.g. 30000/1001 for 29.97."
        },
        "frame_duration": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "duration_frames": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      }
    },
    "music": {
      "type": "object",
      "required": ["file", "duration", "beats", "drops"],
      "properties": {
        "file": { "type": "string" },
        "name": { "type": "string" },
        "duration": { "type": "number" },
        "audio_rate": { "type": "integer" },
        "audio_channels": { "type": "integer" },
        "bpm": { "type": ["number", "null"] },
        "bpm_confidence": { "enum": ["high", "medium", "low"] },
        "beat_interval": { "type": ["number", "null"] },
        "tempo_map": { "type": "array", "items": { "type": "object", "required": ["time", "bpm"], "properties": { "time": { "type": "number" }, "bpm": { "type": "number" }, "confidence": { "type": "number" } } } },
        "beats": { "type": "array", "items": { "type": "number" } },
        "downbeats": { "type": "array", "items": { "type": "number" } },
        "sections": { "type": "array", "items": { "type": "object", "required": ["start", "end", "label"], "properties": { "start": { "type": "number" }, "end": { "type": "number" }, "label": { "type": "string" }, "energy": { "type": "number" }, "trend": { "type": "string" } } } },
        "drops": { "type": "array", "items": { "type": "object", "required": ["time"], "properties": { "time": { "type": "number" }, "build_start": { "type": ["number", "null"] }, "impact_end": { "type": ["number", "null"] }, "rank": { "type": "integer" }, "confidence": { "type": "string" }, "confidence_score": { "type": "number" }, "profile": { "type": ["string", "null"] } } } },
        "pacing": { "type": "object" }
      }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "angle_id", "file", "offset", "duration"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "angle_id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "file": { "type": "string" },
          "offset": { "type": "number", "description": "Timeline position of the camera's first frame (seconds). Negative = camera started before the music." },
          "offset_frames": { "type": "integer" },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "has_video": { "type": "boolean" },
          "has_audio": { "type": "boolean" },
          "width": { "type": ["integer", "null"] },
          "height": { "type": ["integer", "null"] },
          "fps": { "type": ["number", "null"] },
          "timecode": { "type": ["string", "null"] },
          "sync": { "type": "object", "properties": { "method": { "enum": ["audio", "manual", "none"] }, "confidence": { "enum": ["high", "medium", "low"] } } }
        }
      }
    },
    "edit_points": { "type": "array", "items": { "type": "number" } },
    "decisions": { "type": "array", "items": { "type": "object" } },
    "cuts": {
      "type": "array",
      "minItems": 1,
      "description": "Contiguous shots covering frame 0 to timeline.duration_frames. A new cut exists only where the camera changes. camera -1 = no camera covers this range.",
      "items": {
        "type": "object",
        "required": ["index", "start_frame", "end_frame", "camera"],
        "properties": {
          "index": { "type": "integer" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "duration": { "type": "number" },
          "start_frame": { "type": "integer", "minimum": 0 },
          "end_frame": { "type": "integer", "minimum": 1 },
          "camera": { "type": "integer", "minimum": -1 },
          "angle_id": { "type": ["string", "null"] },
          "drop": { "type": ["number", "null"], "description": "Drop time when this shot starts on a detected drop." },
          "reason": { "type": "string" },
          "confidence": { "type": "string" },
          "structure_lock": { "type": "string" }
        }
      }
    },
    "summary": { "type": "array", "items": { "type": "string" } }
  }
}

# Optional. If omitted, a random session token is generated at startup.
RPROJECT_MCP_TOKEN=replace-with-a-long-random-token

# Loopback only. Do not change to 0.0.0.0.
RPROJECT_MCP_HOST=127.0.0.1
RPROJECT_MCP_PORT=47821

# MCP waits this long for Premiere to answer a command.
RPROJECT_MCP_COMMAND_TIMEOUT_MS=45000
